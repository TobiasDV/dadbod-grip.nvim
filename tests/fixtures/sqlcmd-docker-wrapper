#!/usr/bin/env bash
set -euo pipefail

# sqlcmd runs inside the container, so a host path supplied with `-i` is not
# visible there. Copy the file in and point -i at the copy: streaming it over
# stdin instead would let sqlcmd break every line longer than ~4096 bytes.
# `-e SQLCMDPASSWORD` inherits the value without putting it in Docker's argv.
input_file=""
args=()
while (($#)); do
  if [[ "$1" == "-i" ]]; then
    [[ $# -ge 2 ]] || { echo "sqlcmd wrapper: -i requires a file" >&2; exit 2; }
    input_file="$2"
    shift 2
  else
    args+=("$1")
    shift
  fi
done

if [[ -n "$input_file" ]]; then
  target="/tmp/grip-script-$$.sql"
  docker cp "$input_file" "grip-sqlserver:$target" >/dev/null
  status=0
  docker exec -i -e SQLCMDPASSWORD grip-sqlserver \
    /opt/mssql-tools18/bin/sqlcmd "${args[@]}" -i "$target" || status=$?
  docker exec -u 0 grip-sqlserver rm -f "$target"
  exit "$status"
fi

exec docker exec -i -e SQLCMDPASSWORD grip-sqlserver \
  /opt/mssql-tools18/bin/sqlcmd "${args[@]}"
